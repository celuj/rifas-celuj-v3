rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "FhVg6EpradNuZhUd63Cd4grkLbk2";
    }

    // Reservas públicas: cualquier visitante puede crear una reserva nueva,
    // pero nunca modificar o borrar una reserva existente.
    match /rifa/{numero} {
      allow read: if true;

      allow create: if
        !exists(/databases/$(database)/documents/rifa/$(numero))
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
        && request.resource.data.numero is string
        && (request.resource.data.fecha is timestamp || request.resource.data.fecha is string)
        && request.resource.data.pagado == false;

      allow update, delete: if isAdmin();
    }

    // Configuración: pública para lectura, exclusiva del administrador para escritura.
    match /config/{documento} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
