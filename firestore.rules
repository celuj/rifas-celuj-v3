rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "FhVg6EpradNuZhUd63Cd4grkLbk2";
    }

    // Compatibilidad/migración de la V6 anterior.
    // El público ya no puede leer ni escribir esta colección.
    match /rifa/{numero} {
      allow read, write: if isAdmin();
    }

    // Cada modalidad de rifa tiene su propia colección.
    // Así 00–99, 0–9 y combos son completamente independientes.
    match /rifa_normal/{numero} {
      allow read: if true;
      allow create: if
        !exists(/databases/$(database)/documents/rifa_normal/$(numero))
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
        && request.resource.data.numero is string
        && (request.resource.data.fecha is timestamp || request.resource.data.fecha is string)
        && request.resource.data.pagado == false;
      allow update, delete: if isAdmin();
    }

    match /rifa_mini/{numero} {
      allow read: if true;
      allow create: if
        !exists(/databases/$(database)/documents/rifa_mini/$(numero))
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
        && request.resource.data.numero is string
        && (request.resource.data.fecha is timestamp || request.resource.data.fecha is string)
        && request.resource.data.pagado == false;
      allow update, delete: if isAdmin();
    }

    match /rifa_combo/{combo} {
      allow read: if true;
      allow create: if
        !exists(/databases/$(database)/documents/rifa_combo/$(combo))
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
        && request.resource.data.numero is string
        && (request.resource.data.fecha is timestamp || request.resource.data.fecha is string)
        && request.resource.data.pagado == false;
      allow update, delete: if isAdmin();
    }

    match /config/{documento} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
